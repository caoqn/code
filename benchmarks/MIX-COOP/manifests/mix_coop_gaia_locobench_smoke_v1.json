{
  "schema_version": 1,
  "suite_id": "mix-coop-gaia-locobench-smoke-v1",
  "active_benchmarks": [
    "gaia",
    "locobench"
  ],
  "description": "Protocol smoke: 2 evolve and 4 test tasks per benchmark, preserving the GAIA-first round-robin order from the pilot.",
  "ordering": {
    "strategy": "stratified_round_robin",
    "seed": 20260822,
    "round_unit": "one GAIA task plus one LoCoBench task",
    "shuffle_within_round": false
  },
  "shared_evolution": {
    "mode": "single_team_workspace",
    "team_name": "pool_MIX_COOP",
    "state_root": "agents/pool_MIX_COOP",
    "require_common_agent_namespace": true,
    "shared_artifacts": [
      "templates.json",
      "handoff_rules.json",
      "constitution.md",
      "pool.yaml",
      "*/evolution/prompt_patches.md",
      "*/evolution/teammate_profiles.yaml",
      "*/skills/**"
    ],
    "evolution_policy": {
      "evolve_phase": "sequential_updates_after_each_successfully_evaluated_task",
      "test_phase": "frozen_read_only_snapshot"
    }
  },
  "isolation_policy": {
    "selector_visible_fields": [
      "native_full_task",
      "normalized_collaboration_evidence",
      "family_catalog"
    ],
    "selector_hidden_fields": [
      "mix_task_id",
      "source_benchmark",
      "source_split",
      "source_task_id",
      "source_index",
      "adapter_module",
      "native_evaluator",
      "hidden_annotations"
    ],
    "native_components": [
      "tool_environment",
      "task_construction",
      "output_contract",
      "artifact_collection",
      "evaluator"
    ],
    "score_policy": "retain_native_score_and_compute_cross-suite_metrics_only_during_aggregation"
  },
  "benchmark_bindings": {
    "gaia": {
      "adapter_module": "benchmarks.adapter_gaia",
      "adapter_class": "GAIAAdapter",
      "task_construction": "GAIAAdapter.build_task",
      "native_environment": "GAIA attachment workspace and retrieval tools",
      "execution_policy": "knowledge_question_with_optional_attachment",
      "execution_policy_version": "1",
      "output_contract": "gaia_short_answer",
      "submission_type": "strict_short_answer",
      "native_evaluator": "GAIAAdapter.evaluate",
      "native_allowed_tools": [
        "read_file",
        "write_file",
        "bash",
        "web_search",
        "web_fetch"
      ]
    },
    "locobench": {
      "adapter_module": "benchmarks.adapter_locobench",
      "adapter_class": "LoCoBenchAdapter",
      "task_construction": "LoCoBenchAdapter.build_task",
      "native_environment": "isolated solution workspace and native scenario context",
      "execution_policy": "long_context_solution_workspace",
      "execution_policy_version": "1",
      "output_contract": "locobench_solution_summary",
      "submission_type": "solution_files_plus_completion_summary",
      "native_evaluator": "LoCoBenchAdapter.evaluate",
      "native_allowed_tools": [
        "read_file",
        "write_file",
        "bash"
      ]
    }
  },
