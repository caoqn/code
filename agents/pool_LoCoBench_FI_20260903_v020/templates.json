    },
    {
      "family_id": "family_de3621cfd1f7",
      "description": "A cross-file feature-engineering collaboration that combines architectural dependency tracing, complementary codebase reading, integration design, implementation, and independent review and verification. Members contribute distinct perspectives while relying on explicit requirement mapping, interface consistency, compilation, and behavioral checks as evidence; it applies to substantial repository changes spanning multiple layers, but is unnecessary for isolated edits or narrowly scoped analysis.",
      "current_template_id": "tpl_family_de3621cfd1f7_11473122",
      "handoff_family_id": "hf_family_de3621cfd1f7",
