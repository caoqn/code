{
  "schema_version": 2,
  "families": [
    {
      "family_id": "family_0a55f6809378",
      "description": "A coordinated pattern in which one member establishes structural context, another produces the change, an integrator reconciles distributed artifacts and claims, and an independent verifier checks observable postconditions against authoritative evidence. It suits multi-part tasks requiring consistency across several outputs or systems, but is unnecessary for isolated, self-contained work with a single readily verifiable result.",
      "current_template_id": "tpl_family_0a55f6809378_2d6ecfa8",
      "handoff_family_id": "hf_family_0a55f6809378",
      "created_at": "2026-09-04T04:36:40.305367+00:00",
      "updated_at": "2026-09-04T13:28:41.112530+00:00"
    },
    {
      "family_id": "family_1693c5057c2e",
      "description": "A focused evidence-extraction and independent-checking collaboration in which one member structures and interprets the provided source while the other recomputes the result and tests the conclusion against the underlying evidence. It is suited to bounded, source-grounded comparison or aggregation tasks where reproducibility and numerical or factual verification matter, but not to work requiring substantial artifact construction or external research.",
      "current_template_id": "tpl_family_1693c5057c2e_5631202f",
      "handoff_family_id": "hf_family_1693c5057c2e",
      "created_at": "2026-09-04T15:26:56.217891+00:00",
      "updated_at": "2026-09-04T15:26:56.217895+00:00"
    },
    {
      "family_id": "family_1f3879e74591",
      "description": "A compact evidence-and-checking collaboration in which one member gathers precise, source-grounded facts and another independently validates the resulting claim or calculation. Members complement retrieval with skeptical verification, relying on traceable evidence, explicit uncertainty, and reproducible checks rather than unsupported conclusions. This pattern suits bounded fact-finding and answer-validation tasks where authoritative external material must be interpreted and cross-checked, but not broad implementation or open-ended synthesis.",
      "current_template_id": "tpl_family_1f3879e74591_5f43c680",
      "handoff_family_id": "hf_family_1f3879e74591",
      "created_at": "2026-09-04T03:14:24.271156+00:00",
      "updated_at": "2026-09-04T03:14:24.271159+00:00"
    },
    {
      "family_id": "family_226a432ddc09",
      "description": "An evidence-grounded implementation and validation pattern in which external evidence and local structural analysis inform a focused artifact change, while an implementer turns the diagnosis into a deliverable and an independent verifier checks behavior, regressions, and unresolved environmental limits. It is suited to compatibility-sensitive engineering and other tasks requiring both construction and reproducible validation, but is less applicable to purely creative work or simple fact retrieval.",
      "current_template_id": "tpl_family_226a432ddc09_de608d3b",
      "handoff_family_id": "hf_family_226a432ddc09",
      "created_at": "2026-09-04T01:56:16.640620+00:00",
      "updated_at": "2026-09-04T02:41:51.500916+00:00"
    },
    {
      "family_id": "family_7c7cb524329f",
      "description": "A focused collaboration pattern in which one member maps the existing structure and dependencies, another makes the localized artifact changes, and a third independently verifies consistency and behavior. The pattern relies on reproducible structural evidence, clear change provenance, and compilation or targeted behavioral checks rather than assumptions. It applies to bounded refactors and similar small-to-medium code changes where understanding, implementation, and independent validation are all useful, but not to work requiring extensive external research or broad system redesign.",
      "current_template_id": "tpl_family_7c7cb524329f_ffd0d453",
      "handoff_family_id": "hf_family_7c7cb524329f",
      "created_at": "2026-09-05T00:04:36.832086+00:00",
      "updated_at": "2026-09-05T00:04:36.832088+00:00"
    },
    {
      "family_id": "family_af25c04fd6d5",
      "description": "A compact independent-verification pattern in which one member derives the precise answer and checks it against the governing specification or observable evidence. It suits focused, self-contained investigations where correctness depends on exact interpretation and a direct consistency check, but is not intended for work requiring artifact construction, broad evidence gathering, or multi-party integration.",
      "current_template_id": "tpl_family_af25c04fd6d5_5debc647",
      "handoff_family_id": "hf_family_af25c04fd6d5",
      "created_at": "2026-09-04T15:36:09.946833+00:00",
      "updated_at": "2026-09-04T15:36:09.946837+00:00"
    },
    {
      "family_id": "family_f39760586acd",
      "description": "A repository-grounded build-and-validation collaboration in which one member maps structure and dependencies, another produces the change, an integrator reconciles cross-component contracts and keeps the result coherent, and a verifier independently checks behavior against explicit requirements. Evidence comes from inspected artifacts, focused tests, and end-to-end consistency checks rather than assumptions; this pattern fits multi-surface software changes and other deliverables where integration risk matters, but is unnecessary for isolated edits or purely exploratory analysis.",
      "current_template_id": "tpl_family_f39760586acd_22edd9cf",
      "handoff_family_id": "hf_family_f39760586acd",
      "created_at": "2026-09-04T01:47:57.461007+00:00",
      "updated_at": "2026-09-04T16:35:22.332530+00:00"
    }
  ],
