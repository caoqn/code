  "schema_version": 2,
  "families": [
    {
      "family_id": "family_3a2fcdc6bf09",
      "description": "A focused evidence-retrieval and verification pairing for factual lookups: one member locates relevant primary or authoritative records while the other independently checks the identity, provenance, and exact wording of the conclusion. The pattern favors source triangulation and explicit consistency checks, and applies to bounded questions where the answer must be grounded in publicly inspectable historical or documentary evidence.",
      "current_template_id": "tpl_family_3a2fcdc6bf09_48284b50",
      "handoff_family_id": "hf_family_3a2fcdc6bf09",
      "created_at": "2026-09-02T02:45:36.552659+00:00",
      "updated_at": "2026-09-02T02:45:36.552661+00:00"
    },
    {
      "family_id": "family_75cdfe072426",
      "description": "A document-evidence collaboration pattern in which one member extracts and interprets relevant content while another independently checks the inferred result against the source and the requested answer constraints. It suits tasks requiring dependable answers from provided documents, especially where omission or cross-reference errors matter, but is not intended for open-ended research or specialized computation.",
      "current_template_id": "tpl_family_75cdfe072426_d0a367eb",
      "handoff_family_id": "hf_family_75cdfe072426",
      "created_at": "2026-09-02T02:50:11.166309+00:00",
      "updated_at": "2026-09-02T02:50:11.166313+00:00"
    },
    {
      "family_id": "family_e1e40474ced6",
      "description": "A quantitative problem-solving collaboration combines scientific reasoning to derive the result, reproducible computational analysis when the structure benefits from enumeration or calculation, and independent verification of assumptions, arithmetic, and final formatting. Members complement one another by separating derivation, implementation, and validation; conclusions should be supported by transparent reasoning and cross-checks. This pattern applies to well-defined numerical or formal reasoning tasks, but is unnecessary for purely qualitative work or tasks requiring chiefly external evidence.",
      "current_template_id": "tpl_family_e1e40474ced6_2013d404",
      "handoff_family_id": "hf_family_e1e40474ced6",
      "created_at": "2026-09-02T05:06:51.927835+00:00",
      "updated_at": "2026-09-02T05:06:51.927837+00:00"
    },
    {
      "family_id": "family_fbd75283f5f4",
      "description": "A focused validation-centered collaboration pattern in which an independent checker resolves narrowly scoped requests and confirms that the response satisfies the stated output constraints. Reliability rests on direct interpretation, minimal necessary inference, and explicit checking of answer form and meaning; it applies to small, self-contained tasks where external research, implementation, or broader specialist coverage is not warranted.",
      "current_template_id": "tpl_family_fbd75283f5f4_570a8cf8",
      "handoff_family_id": "hf_family_fbd75283f5f4",
      "created_at": "2026-09-02T05:09:30.951301+00:00",
      "updated_at": "2026-09-02T05:09:30.951303+00:00"
    }
  ],
